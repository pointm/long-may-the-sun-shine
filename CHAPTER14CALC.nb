Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"3", 
      RowBox[{"x", "^", "2"}]}], "-", 
     RowBox[{"5", 
      RowBox[{"y", "^", "3"}]}]}], "==", "11"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.9323554380647526`*^9, {3.932355514307007*^9, 3.9323555751567993`*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"c0e88ba9-deef-e548-bcde-29240402240e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"y", "\[Equal]", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", 
        FractionBox["1", "5"]}], ")"}], 
      RowBox[{"1", "/", "3"}]]}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "11"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["x", "2"]}]}], ")"}], 
     RowBox[{"1", "/", "3"}]]}]}], "||", 
  RowBox[{"y", "\[Equal]", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "11"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["x", "2"]}]}], ")"}], 
     RowBox[{"1", "/", "3"}]], 
    SuperscriptBox["5", 
     RowBox[{"1", "/", "3"}]]]}], "||", 
  RowBox[{"y", "\[Equal]", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"2", "/", "3"}]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "11"}], "+", 
        RowBox[{"3", " ", 
         SuperscriptBox["x", "2"]}]}], ")"}], 
      RowBox[{"1", "/", "3"}]]}], 
    SuperscriptBox["5", 
     RowBox[{"1", "/", "3"}]]]}]}]], "Output",
 CellChangeTimes->{{3.932355534031391*^9, 3.932355576392874*^9}},
