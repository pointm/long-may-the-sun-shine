Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wavr", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Eta]", " ", 
      SuperscriptBox["I0", "2"], " ", 
      SuperscriptBox["k", "2"], " ", 
      SuperscriptBox["l", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
     RowBox[{"32", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      SuperscriptBox["r", "2"]}]], "-", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", "\[Eta]", " ", 
      SuperscriptBox["I0", "2"], " ", 
      SuperscriptBox["l", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
     RowBox[{"32", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", "k", " ", 
      SuperscriptBox["r", "5"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ptotal", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"wavr", "*", 
     RowBox[{"r", "^", "2"}], "*", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", "0", ",", 
      RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}]}]}], "Input",
