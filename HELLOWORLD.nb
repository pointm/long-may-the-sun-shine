          RowBox[{"-", "1"}], "+", 
          SqrtBox["5"]}], ")"}], " ", "x"}], "+", 
       SuperscriptBox["x", "2"]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SqrtBox["5"]}], ")"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox["5"]}], ")"}], " ", "x"}], "+", 
       SuperscriptBox["x", "2"]}], "]"}]}]}], ")"}]}]], "Output",
