           SqrtBox["5"]}], ")"}]}]]], "]"}]}], "+", 
    RowBox[{"4", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", "x"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
