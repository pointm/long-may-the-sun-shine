       RowBox[{"-", "1"}], "+", 
       SqrtBox["5"]}], ")"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
