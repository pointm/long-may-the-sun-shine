Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=yes TopDesignName="LEARNINGADS_lib:TestBench_MyFilter:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes DcopOutputAllSweepPoints=no DcopOutputDcopType=0
; Library Name: LEARNINGADS_lib
; Cell Name: Design1
; View Name: schematic
define Design1 ( P1  P2 ) 
;parameters 
L:L1  P1 N__6 L=34.1053 nH tune{ 10 nH to 1500 nH by 10 nH } opt{ 10 nH to 150 nH } Noise=yes  
L:L2  N__6 N__9 L=74.8743 nH tune{ 10 nH to 1500 nH by 10 nH } opt{ 10 nH to 150 nH } Noise=yes  
L:L3  N__9 P2 L=45.1585 nH tune{ 1 nH to 150 nH by 1 nH } opt{ 10 nH to 150 nH } Noise=yes  
C:C1  N__6 0 C=14.9999 pF tune{ 10 pF to 1200 pF by 8 pF } opt{ 1 pF to 25 pF } 
C:C2  N__9 0 C=19.2726 pF tune{ 1 pF to 150 pF by 1 pF } opt{ 1 pF to 25 pF } 
end Design1

Design1:X1  N__1 N__0 
S_Param:SP1 CalcS=yes CalcY=no CalcZ=no CalcGroupDelay=yes GroupDelayAperture=1e-4 \
FreqConversion=no FreqConversionPort=1 StatusLevel=2 CalcNoise=no SortNoise=0 BandwidthForNoise=1.0 Hz DevOpPtLevel=0 SPSS_WSP=yes \
SweepVar="freq" SweepPlan="SP1_stim" OutputPlan="SP1_Output" 

SweepPlan: SP1_stim Start=0 GHz Stop=0.5 GHz Lin=101 

OutputPlan:SP1_Output \
      Type="Output" \
      UseEquationNestLevel=yes \
      EquationNestLevel=2 \
      UseSavedEquationNestLevel=yes \
      SavedEquationNestLevel=2

#load "python","LinearCollapse"
Component Module="LinearCollapse" Type="ModelExtractor" NetworkRepresentation=2
