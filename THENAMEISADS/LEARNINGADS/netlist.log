; Cell Name: Design1
; View Name: schematic
define Design1 ( P1  P2 ) 
;parameters 
L:L1  P1 N__6 L=308 nH tune{ 10 nH to 1500 nH by 10 nH } Noise=yes  
L:L2  N__6 N__9 L=963.6 nH tune{ 10 nH to 1500 nH by 10 nH } Noise=yes  
L:L3  N__9 P2 L=121.69 nH tune{ 1 nH to 150 nH by 1 nH } Noise=yes  
